  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": "'Fraunces', 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, 'Times New Roman', serif"
      },
      "body": {
        "$type": "fontFamily",
        "$value": "'Source Sans 3', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
      }
    }
  },
  "type": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "3.75rem",
        "fontWeight": 700,
        "lineHeight": 1.1,
        "letterSpacing": "-0.02em"
      },
      "$description": "Campaign headlines, hero banners (one per page)"
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "3rem",
        "fontWeight": 700,
        "lineHeight": 1.15,
        "letterSpacing": "-0.015em"
      },
      "$description": "Page titles"
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "2.25rem",
        "fontWeight": 700,
        "lineHeight": 1.2,
        "letterSpacing": "-0.01em"
      },
      "$description": "Section titles"
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "1.75rem",
        "fontWeight": 600,
        "lineHeight": 1.25,
        "letterSpacing": "0"
      },
      "$description": "Sub-sections"
    },
    "h4": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": "1.375rem",
        "fontWeight": 600,
        "lineHeight": 1.3,
        "letterSpacing": "0"
      },
      "$description": "Card and component titles"
    },
    "body-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": "1.25rem",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "0"
      },
      "$description": "Introductions and lead paragraphs"
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": "1rem",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "0"
      },
      "$description": "Default body text (never smaller on screen)"
    },
    "small": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": "0.875rem",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "0.01em"
      },
      "$description": "Captions, metadata, legal (not for long passages)"
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": "0.875rem",
        "fontWeight": 600,
        "lineHeight": 1.4,
        "letterSpacing": "0.02em"
      },
      "$description": "Buttons, form labels, tags"
    },
    "code": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "0.9375rem",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "0"
      },
      "$description": "Code, data, reference numbers"
    }
  },
