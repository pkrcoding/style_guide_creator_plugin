  "shadow": {
    "0": {
      "$type": "shadow",
      "$value": "none"
    },
    "1": {
      "$type": "shadow",
      "$value": "0 1px 2px rgb(0 0 0 / 0.08), 0 1px 1px rgb(0 0 0 / 0.04)"
    },
    "2": {
      "$type": "shadow",
      "$value": "0 4px 8px rgb(0 0 0 / 0.08), 0 2px 4px rgb(0 0 0 / 0.04)"
    },
    "3": {
      "$type": "shadow",
      "$value": "0 12px 24px rgb(0 0 0 / 0.10), 0 4px 8px rgb(0 0 0 / 0.05)"
    }
  },
  "motion": {
    "duration": {
      "instant": {
        "$type": "duration",
        "$value": "0ms"
      },
      "fast": {
        "$type": "duration",
        "$value": "120ms"
      },
      "base": {
        "$type": "duration",
        "$value": "200ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "320ms"
      },
      "deliberate": {
        "$type": "duration",
        "$value": "500ms"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "enter": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0, 0, 0, 1)"
      },
      "exit": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.3, 0, 1, 1)"
      }
    }
  },
  "breakpoint": {
    "mobile": {
      "$type": "dimension",
